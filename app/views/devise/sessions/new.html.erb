<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4">
  <div class="w-full max-w-md bg-white rounded-xl shadow-lg p-8">
    <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">Sign in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-4">
        <%= f.label :email, class: "block text-gray-700 font-medium mb-1" %>
        <%= f.email_field :email, autofocus: true, class: "w-full border-2 border-solid border-purple-300 rounded-lg px-3 py-2 focus:ring-purple-500 focus:border-purple-500" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, class: "block text-gray-700 font-medium mb-1" %>
        <%= f.password_field :password, class: "w-full border-2 border-solid border-purple-300 rounded-lg px-3 py-2 focus:ring-purple-500 focus:border-purple-500" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center mb-4">
          <%= f.check_box :remember_me, class: "mr-2 rounded border-gray-300" %>
          <%= f.label :remember_me, class: "text-gray-700" %>
        </div>
      <% end %>

      <%= f.submit "Sign in", class: "w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 rounded-lg transition" %>
    <% end %>

    <div class="mt-4 text-center">
      <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm text-purple-600 hover:text-purple-800" %><br>
      <%= link_to "Sign up", new_registration_path(resource_name), class: "text-sm text-gray-700 hover:text-purple-600" %>
    </div>
  </div>
</div>
