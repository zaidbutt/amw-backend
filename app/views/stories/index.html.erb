<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @stories.each do |story| %>
    <div class="bg-white rounded-lg shadow p-5 hover:shadow-lg transition">
      <% if story.image.attached? %>
        <%= image_tag story.image, size: 400, class: "rounded-md mb-3 w-full h-48 object-cover" %>
      <% else %>
        <div class="bg-gray-100 h-48 rounded-md flex items-center justify-center text-gray-500">No Image</div>
      <% end %>

      <h3 class="text-lg font-semibold text-gray-800 mb-1"><%= story.title %></h3>
      <p class="text-sm text-gray-600 mb-3">Invite Code: <%= story.inviteCode %></p>
      <%= link_to "View Story", story_path(story), class: "bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md text-sm" %>
    </div>
  <% end %>
</div>
