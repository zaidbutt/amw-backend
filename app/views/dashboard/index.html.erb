<h1 class="text-2xl font-semibold mb-6">Dashboard</h1>

<h1 class="text-2xl font-semibold mb-6 flex items-center justify-between">
  <%= link_to "Create New Story", new_story_path,
        class: "bg-purple-600 hover:bg-purple-700 text-white font-medium px-4 py-2 rounded-md shadow-sm transition" %>
</h1>

<!-- Stories Section -->
<section class="mb-8">
  <h2 class="text-lg font-semibold mb-3 text-gray-700">Your Stories</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @stories.each do |story| %>
      <div class="bg-white shadow rounded-lg p-5 hover:shadow-lg transition">
        <h3 class="text-xl font-semibold text-gray-800 mb-1"><%= story[:title] %></h3>
        <p class="text-gray-600 text-sm mb-1">Author: <%= story.user.email %></p>
        <p class="text-gray-500 text-sm mb-3"><%= story.chapters.count %> chapters</p>
        <%= link_to "Open Story", story_path(story), class: "bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md text-sm" %>
      </div>
    <% end %>
  </div>
</section>

<!-- Notifications Section -->
<section>
  <h2 class="text-lg font-semibold mb-3 text-gray-700">Notifications</h2>
  <div class="bg-white shadow rounded-lg p-5 space-y-4">
    <% @notifications.each do |note| %>
      <div class="border-b border-gray-200 pb-3 last:border-none">
        <h3 class="font-semibold text-gray-800"><%= note[:title] %></h3>
        <p class="text-gray-600 text-sm"><%= note[:message] %></p>
      </div>
    <% end %>
  </div>
</section>
