<!-- Top strip (like the wireframe header bar) -->
<div class="mb-6 rounded-2xl bg-amw-ink text-white px-6 py-4 shadow">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-white/10 grid place-content-center">
        <!-- simple brand dot -->
        <div class="w-3 h-3 rounded-full bg-white/80"></div>
      </div>
      <h1 class="font-display text-2xl">Dashboard</h1>
    </div>

    <div class="flex items-center gap-3">
      <div class="hidden md:flex items-center gap-2 bg-white/10 rounded-xl px-3 py-1.5">
        <span class="text-sm text-white/90">Welcome,</span>
        <strong class="text-sm"><%= current_user.email %></strong>
      </div>
      <%= link_to "Logout", destroy_user_session_path, method: :delete, data: { turbo: false },
            class: "bg-white text-amw-ink hover:bg-amw-lilac hover:text-white transition px-3 py-1.5 rounded-xl font-medium" %>
    </div>
  </div>
</div>

<div class="grid xl:grid-cols-3 gap-6">
  <!-- Left: Stories table (xl spans 2 cols) -->
  <section class="xl:col-span-2 space-y-4">
    <div class="amw-card">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-xl">Your Stories</h2>
        <div class="flex items-center gap-2">
          <input type="text" placeholder="Search stories…" class="rounded-xl border border-amw-mist px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amw-lilac" />
          <button class="amw-btn bg-amw-sky hover:bg-amw-ink">New Story</button>
        </div>
      </div>

      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-amw-ink/60">
              <th class="py-2">Story</th>
              <th class="py-2">Chapters</th>
              <th class="py-2">Moments</th>
              <th class="py-2">Status</th>
              <th class="py-2 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-amw-mist">
            <% @stories.each do |s| %>
              <tr class="hover:bg-amw-mist/40">
                <td class="py-3 font-medium"><%= s[:title] %></td>
                <td class="py-3"><%= s[:chapters] %></td>
                <td class="py-3"><%= s[:moments] %></td>
                <td class="py-3">
                  <%# status chip %>
                  <% if s[:status] == :active %>
                    <span class="amw-chip bg-green-100 text-green-700">Active</span>
                  <% else %>
                    <span class="amw-chip bg-yellow-100 text-yellow-800">Paused</span>
                  <% end %>
                </td>
                <td class="py-3">
                  <div class="flex justify-end gap-2">
                    <a href="#" class="amw-btn bg-amw-sky hover:bg-amw-ink">Open</a>
                    <button class="amw-chip">Share</button>
                    <button class="amw-chip">More</button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick actions / shortcuts -->
    <div class="grid md:grid-cols-3 gap-4">
      <div class="amw-card">
        <div class="font-medium">Add Moment</div>
        <p class="text-amw-ink/60 text-sm mt-1">Upload photo/video to a chapter.</p>
        <div class="mt-3">
          <button class="amw-btn">Upload</button>
        </div>
      </div>
      <div class="amw-card">
        <div class="font-medium">Create Chapter</div>
        <p class="text-amw-ink/60 text-sm mt-1">Organize moments in a story.</p>
        <div class="mt-3">
          <button class="amw-btn">New Chapter</button>
        </div>
      </div>
      <div class="amw-card">
        <div class="font-medium">Invite</div>
        <p class="text-amw-ink/60 text-sm mt-1">Add owners or connections.</p>
        <div class="mt-3">
          <button class="amw-btn">Invite</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Right: Notifications & storage -->
  <aside class="space-y-4">
    <div class="amw-card">
      <div class="flex items-center justify-between">
        <h3 class="font-display text-lg">Notifications</h3>
        <a href="#" class="text-amw-sky text-sm">View all</a>
      </div>
      <ul class="mt-3 space-y-2">
        <% @notifications.each do |n| %>
          <li class="bg-amw-mist/60 rounded-xl px-3 py-2 flex items-center justify-between">
            <span class="text-sm"><%= n[:text] %></span>
            <span class="text-xs text-amw-ink/50"><%= n[:time] %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="amw-card">
      <h3 class="font-display text-lg mb-2">Storage</h3>
      <div class="h-2 rounded-full bg-amw-mist overflow-hidden">
        <div class="h-full w-2/3 bg-amw-lilac"></div>
      </div>
      <div class="mt-2 text-sm text-amw-ink/70"><strong>66%</strong> used — 6.6 GB of 10 GB</div>
      <button class="amw-btn mt-3 bg-amw-ink hover:bg-amw-lilac">Manage Plan</button>
    </div>
  </aside>
</div>
